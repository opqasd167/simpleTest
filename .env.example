# .env.example -> copy to .env and fill in. NEVER commit .env

# ---- Which LLM to use ----
# anthropic = company LLM gateway (production); grok_cli = local Grok CLI simulator (development)
KM_LLM_PROVIDER=anthropic

# ---- LLM access (company network) ----
# Paste the token your company gave you here:
KM_LLM_API_TOKEN=
# Company LLM gateway URL. Leave empty to call api.anthropic.com directly.
KM_LLM_BASE_URL=
# How the gateway expects the token: api_key (x-api-key header) or bearer (Authorization: Bearer)
KM_LLM_AUTH_MODE=api_key
KM_LLM_MODEL=claude-opus-5-5
# Set to false if your gateway rejects the server-side fallback beta
KM_LLM_SERVER_FALLBACKS=true

# ---- Grok CLI simulator (only used when KM_LLM_PROVIDER=grok_cli) ----
KM_GROK_BIN=grok
# Leave empty for the CLI's default model
KM_GROK_MODEL=
# low | medium | high; empty = CLI default. low is much faster for local testing
KM_GROK_EFFORT=

# ---- Corporate proxy and certificates (only if IT requires them) ----
# HTTPS_PROXY=http://proxy.yourcompany.local:8080
# Company root CA certificate, if HTTPS inspection is used. Keep these lines commented out
# when unused: an EMPTY value is not the same as unset and can break HTTPS.
# SSL_CERT_FILE=C:\certs\company-root.pem

# ---- Monitoring (Langfuse): leave the keys empty to turn tracing off ----
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Company Langfuse URL, or https://cloud.langfuse.com
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# false = send no prompts, answers or document text
KM_TRACE_CONTENT=true
